APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_LONG_POLLING=true
TELEGRAM_ADMIN_CHAT_IDS=

DATA_DIR=./data
DATABASE_PATH=./data/gifhub.sqlite3
DATABASE_URL=postgresql+psycopg://gifhub:gifhub@postgres:5432/gifhub
REDIS_URL=redis://redis:6379/0
PUBLIC_BASE_URL=http://localhost:8000

MAX_UPLOAD_BYTES=10485760
MAX_VIDEO_DURATION_SECONDS=20
MAX_OUTPUT_GIF_BYTES=10485760
MAX_OUTPUT_MP4_BYTES=10485760
MAX_DIMENSION_PX=1280
TARGET_GIF_WIDTH_PX=480
TARGET_MP4_WIDTH_PX=640
TARGET_GIF_FPS=12
TARGET_MP4_FPS=24
STATIC_IMAGE_DURATION_SECONDS=3
MAX_TAGS_PER_MEDIA=3
MIN_TAGS_PER_MEDIA=1

FFMPEG_TIMEOUT_SECONDS=120
FFPROBE_TIMEOUT_SECONDS=20
SIGNED_URL_TTL_SECONDS=300
